---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable" description="La page demandée n'existe pas.">
  <section class="section">
    <div class="wrap center">
      <p class="code mono">404</p>
      <h1>Cette page n'existe pas.</h1>
      <p class="lede">Le lien est peut-être ancien ou l'adresse mal saisie.</p>
      <div class="cta">
        <a class="btn btn-primary" href="/labo/">Retour à l'accueil</a>
        <a class="btn btn-ghost" href="/labo/modeles">Voir les modèles</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .center {
    text-align: center;
    padding-block: clamp(3rem, 10vw, 7rem);
  }

  .center .lede {
    margin-inline: auto;
  }

  .code {
    color: var(--accent);
    font-size: 1rem;
    letter-spacing: 0.3em;
    margin-bottom: 1rem;
  }

  .cta {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
</style>
