---
import Base from '../layouts/Base.astro';
import { externalLinks } from '../data/siteData';
import { support, donors } from '../data/support';

const pct = Math.min(100, (support.raisedEur / support.goalEur) * 100);
const fmtEur = (v: number) => v.toLocaleString('fr-FR').replace(/,/g, ' ') + ' €';
---

<Base
  title="Contribuer"
  description="Soutenez la recherche du laboratoire : cagnotte GoFundMe, usage des fonds, montants publics."
>
  <section class="section page-head">
    <div class="wrap">
      <h1>Contribuer</h1>
      <p class="lede">
        La recherche coûte du calcul et du matériel. Chaque don finance
        directement les runs, pas une structure.
      </p>
    </div>
  </section>

  <section class="section gauge-section">
    <div class="wrap">
      <div class="card gauge-card" style="--c: var(--c-orange)">
        <div class="gauge-top">
          <div>
            <p class="eyebrow" style="--c: var(--c-orange)">Cagnotte GoFundMe</p>
            <p class="gauge-amount">{fmtEur(support.raisedEur)}</p>
            <p class="gauge-sub">
              récoltés sur {fmtEur(support.goalEur)} · {support.donations} dons
            </p>
          </div>
          <a class="btn btn-primary" href={externalLinks.gofundme} rel="external">
            Faire un don
          </a>
        </div>
        <div
          class="gauge-track"
          role="img"
          aria-label={`${support.raisedEur} euros récoltés sur ${support.goalEur}, ${support.donations} dons`}
        >
          <div class="gauge-fill" style={`width:${pct}%`}></div>
        </div>
        <p class="gauge-note">Chiffres publics, mis à jour le {support.updated}.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Ils ont donné</h2>
      <div class="card donor-card">
        <ul class="donor-list">
          {donors.map((d) => (
            <li>
              <span>{d.name}</span>
              <span class="mono donor-amount">{fmtEur(d.eur)}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-bottom: 0;
  }

  .gauge-section {
    padding-bottom: 0;
  }

  .gauge-card {
    border-color: color-mix(in srgb, var(--c-orange) 55%, white);
  }

  .gauge-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .gauge-top .eyebrow {
    margin-bottom: 0.7rem;
  }

  .gauge-amount {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .gauge-sub {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }

  .gauge-top .btn {
    flex-shrink: 0;
  }

  .gauge-track {
    margin-top: 1.75rem;
    height: 0.85rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .gauge-fill {
    height: 100%;
    background: var(--c-orange);
    border-radius: 999px;
    min-width: 4px;
  }

  .gauge-note {
    margin: 0.85rem 0 0;
    font-size: 0.85rem;
    color: var(--faint);
  }

  .donor-card {
    padding: 0.5rem 1.75rem;
  }

  .donor-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .donor-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
  }

  .donor-list li + li {
    border-top: 1px solid var(--line);
  }

  .donor-amount {
    color: var(--muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .gauge-top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
