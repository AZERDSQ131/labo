---
import type { Model } from '../data/modelTypes';

interface Props {
  model: Model;
}

const { model } = Astro.props;
const accent = model.category === 'Sécurité' ? 'var(--c-yellow)' : 'var(--c-blue)';
const favicons = {
  huggingface: '/favicons/huggingface.png',
  ollama: '/favicons/ollama.png',
  github: '/favicons/github.png',
} as const;
---

<article class="model" id={model.slug} style={`--c: ${accent}`}>
  <div class="copy">
    <p class="kicker">{model.category}</p>
    <h2>{model.name}</h2>
    <p class="description">{model.description}</p>
  </div>

  <ul class="links">
    {
      model.links.map((link) => (
        <li>
          <a href={link.href} rel="external">
            <img src={favicons[link.kind]} alt="" width="16" height="16" />
            <span>{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .model {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    padding: 1.6rem 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 5.5rem;
  }

  .kicker {
    margin: 0 0 0.45rem;
    color: color-mix(in srgb, var(--c) 62%, var(--ink));
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.05em;
  }

  .description {
    max-width: 58ch;
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .links {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    font-size: 0.92rem;
  }

  .links img {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .links a:hover span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 720px) {
    .model {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }
</style>
