---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
const nav = [
  { href: base || '/', label: 'Accueil' },
  { href: `${base}/modeles`, label: 'Modèles' },
  { href: `${base}/benchmarks`, label: 'Benchmarks' },
  { href: `${base}/recherche`, label: 'Recherche' },
  { href: `${base}/liens`, label: 'Liens' },
  { href: `${base}/contribuer`, label: 'Contribuer' },
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <button
      id="menu-toggle"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <svg class="icon-burger" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      <svg class="icon-close" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <nav aria-label="Navigation principale" id="site-nav">
      <ul>
        {
          nav.map((item) => {
            const isActive = item.href === (base || '/') ? path === (base || '/') || path === `${base}/` : path.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[{ active: isActive }]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <button id="theme-toggle" type="button" aria-label="Basculer en thème sombre" aria-pressed="false" title="Thème clair / sombre">
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"></path></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path></svg>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');

  if (header) {
    const updateHeaderState = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 0);
    };

    updateHeaderState();
    window.addEventListener('scroll', updateHeaderState, { passive: true });
  }

  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const syncToggle = () => {
    const isDark = root.dataset.theme === 'dark';
    if (toggle) {
      toggle.setAttribute('aria-pressed', String(isDark));
      toggle.setAttribute(
        'aria-label',
        isDark ? 'Basculer en thème clair' : 'Basculer en thème sombre'
      );
    }
  };

  syncToggle();
  const menuToggle = document.getElementById('menu-toggle');
  const siteNav = document.getElementById('site-nav');
  const syncMenu = (open) => {
    if (menuToggle) {
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    }
    if (siteNav) siteNav.classList.toggle('is-open', open);
  };

  if (menuToggle) {
    menuToggle.addEventListener('click', () => {
      syncMenu(menuToggle.getAttribute('aria-expanded') !== 'true');
    });
    siteNav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => syncMenu(false));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') syncMenu(false);
    });
  }
  if (toggle) {
    toggle.addEventListener('click', () => {
      const isDark = root.dataset.theme === 'dark';
      if (isDark) {
        delete root.dataset.theme;
      } else {
        root.dataset.theme = 'dark';
      }
      try {
        localStorage.setItem('labo-theme', isDark ? 'light' : 'dark');
      } catch {
        /* stockage indisponible */
      }
      syncToggle();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .site-header::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--line);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s var(--ease);
  }

  .site-header.is-scrolled::after {
    opacity: 1;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 68px;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
  }

  nav a {
    display: inline-block;
    color: var(--muted);
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }

  nav a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  nav a.active {
    color: var(--c-blue-ink);
    background: color-mix(in srgb, var(--c-blue) 16%, var(--bg));
  }

  #menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    flex-shrink: 0;
  }

  #menu-toggle .icon-close {
    display: none;
  }

  #menu-toggle[aria-expanded='true'] .icon-burger {
    display: none;
  }

  #menu-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  @media (max-width: 720px) {
    .bar {
      height: auto;
      min-height: 68px;
      padding-block: 0.7rem;
      justify-content: flex-end;
    }

    #menu-toggle {
      display: inline-flex;
    }

    nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      background: color-mix(in srgb, var(--bg) 96%, transparent);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
    }

    nav.is-open {
      display: block;
    }

    nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      overflow-x: visible;
      padding: 0.5rem;
    }

    nav a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 0.7rem 1rem;
    }
  }

  #theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  #theme-toggle:hover {
    color: var(--ink);
  }

  #theme-toggle .icon-moon {
    display: none;
  }

  :global(html[data-theme="dark"]) #theme-toggle .icon-moon {
    display: block;
  }

  :global(html[data-theme="dark"]) #theme-toggle .icon-sun {
    display: none;
  }
</style>
